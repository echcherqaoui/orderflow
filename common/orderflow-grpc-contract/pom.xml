<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ═══════════════════════════════════════════════════════════
       Parent POM - Inherits common configuration
   ════════════════════════════════════════════════════════════════ -->
    <parent>
        <groupId>com.echcherqaoui.orderflow</groupId>
        <artifactId>orderflow</artifactId>
        <version>1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <!-- ═══════════════════════════════════════════════════════════
        Project Metadata
    ════════════════════════════════════════════════════════════════ -->
    <artifactId>orderflow-grpc-contract</artifactId>
    <packaging>jar</packaging>
    <name>orderflow-grpc-contracts</name>
    <description>Protocol Buffer schemas and generated gRPC/Kafka stubs for the OrderFlow platform.</description>

    <dependencies>
        <!-- Protocol Buffers Java Core -->
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
        </dependency>

        <!-- gRPC Stubs & Protobuf Bindings -->
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-stub</artifactId>
        </dependency>

        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-protobuf</artifactId>
        </dependency>

        <!-- Provides @javax.annotation.Generated for Protobuf/gRPC generated code -->
        <dependency>
            <groupId>org.apache.tomcat</groupId>
            <artifactId>annotations-api</artifactId>
        </dependency>
    </dependencies>

    <!-- ═══════════════════════════════════════════════════════════
        Build Configuration
    ════════════════════════════════════════════════════════════════ -->
    <build>
        <plugins>
            <plugin>
                <groupId>io.github.ascopes</groupId>
                <artifactId>protobuf-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
