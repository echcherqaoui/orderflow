<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ═══════════════════════════════════════════════════════════
        Parent POM - Inherits common configuration
    ════════════════════════════════════════════════════════════════ -->
    <parent>
        <groupId>com.echcherqaoui.orderflow</groupId>
        <artifactId>orderflow</artifactId>
        <version>1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <!-- ═══════════════════════════════════════════════════════════
        Project Metadata
    ════════════════════════════════════════════════════════════════ -->
    <artifactId>common-kafka</artifactId>
    <packaging>jar</packaging>
    <name>Orderflow :: Common :: Kafka</name>
    <description>Shared Kafka consumer dispatchers, Protobuf event handlers, and listener utilities</description>

    <!-- ═══════════════════════════════════════════════════════════
        DEPENDENCIES
    ════════════════════════════════════════════════════════════════ -->
    <dependencies>
        <!-- Internal modules -->
        <dependency>
            <groupId>com.echcherqaoui.orderflow</groupId>
            <artifactId>common-exceptions</artifactId>
        </dependency>

       <dependency>
            <groupId>com.echcherqaoui.orderflow</groupId>
            <artifactId>common-security</artifactId>
        </dependency>

        <!-- Logging Abstraction -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- Spring Kafka + autoconfigure -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-kafka</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Protocol Buffers Java Core -->
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Confluent Protobuf serializer -->
        <dependency>
            <groupId>io.confluent</groupId>
            <artifactId>kafka-protobuf-serializer</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
