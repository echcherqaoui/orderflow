<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.echcherqaoui.orderflow</groupId>
        <artifactId>orderflow</artifactId>
        <version>1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>orderflow-events-contract</artifactId>
    <packaging>jar</packaging>
    <name>Orderflow :: Events Contract</name>
    <description>Shared Protocol Buffer event schemas and generated Java contracts</description>

    <dependencies>
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
        </dependency>

        <dependency>
            <groupId>io.confluent</groupId>
            <artifactId>kafka-protobuf-serializer</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>io.github.ascopes</groupId>
                <artifactId>protobuf-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>register-schemas</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>io.confluent</groupId>
                        <artifactId>kafka-schema-registry-maven-plugin</artifactId>
                        <version>${kafka-protobuf-serializer.version}</version>
                        <configuration>
                            <schemaRegistryUrls>
                                <schemaRegistryUrl>${schema.registry.url}</schemaRegistryUrl>
                            </schemaRegistryUrls>

                            <messagePath>src/main/proto</messagePath>

                            <subjects>
                                <!-- Matched to QualifiedReferenceSubjectNameStrategy: <package>.<filename> -->
                                <orderflow.common.v1.metadata>src/main/proto/orderflow/common/v1/metadata.proto</orderflow.common.v1.metadata>

                                <!-- Order Command Schemas (RecordNameStrategy) -->
                                <orderflow.payment.commands.v1.ChargePaymentCommand>src/main/proto/orderflow/payment/commands/v1/payment_commands.proto</orderflow.payment.commands.v1.ChargePaymentCommand>
                                <orderflow.payment.commands.v1.CancelPaymentCommand>src/main/proto/orderflow/payment/commands/v1/payment_commands.proto</orderflow.payment.commands.v1.CancelPaymentCommand>
                                <orderflow.inventory.commands.v1.ReleaseInventoryCommand>src/main/proto/orderflow/inventory/commands/v1/inventory_commands.proto</orderflow.inventory.commands.v1.ReleaseInventoryCommand>
                                <orderflow.inventory.commands.v1.ExtendReservationCommand>src/main/proto/orderflow/inventory/commands/v1/inventory_commands.proto</orderflow.inventory.commands.v1.ExtendReservationCommand>
                                <orderflow.inventory.commands.v1.ConfirmReservationCommand>src/main/proto/orderflow/inventory/commands/v1/inventory_commands.proto</orderflow.inventory.commands.v1.ConfirmReservationCommand>

                                <!-- Order Event Schemas (RecordNameStrategy) -->
                                <orderflow.order.v1.OrderCancelledIntegrationEvent>src/main/proto/orderflow/order/v1/order_events.proto</orderflow.order.v1.OrderCancelledIntegrationEvent>

                                <!-- Payment Event Schemas (RecordNameStrategy) -->
                                <orderflow.payment.events.v1.PaymentInitiatedEvent>src/main/proto/orderflow/payment/events/v1/payment_events.proto</orderflow.payment.events.v1.PaymentInitiatedEvent>
                                <orderflow.payment.events.v1.PaymentInitializationFailedEvent>src/main/proto/orderflow/payment/events/v1/payment_events.proto</orderflow.payment.events.v1.PaymentInitializationFailedEvent>
                                <orderflow.payment.events.v1.PaymentCancelledEvent>src/main/proto/orderflow/payment/events/v1/payment_events.proto</orderflow.payment.events.v1.PaymentCancelledEvent>
                                <orderflow.payment.events.v1.PaymentChargedEvent>src/main/proto/orderflow/payment/events/v1/payment_events.proto</orderflow.payment.events.v1.PaymentChargedEvent>
                                <orderflow.payment.events.v1.PaymentFailedEvent>src/main/proto/orderflow/payment/events/v1/payment_events.proto</orderflow.payment.events.v1.PaymentFailedEvent>

                                <!-- Inventory Event Schemas (RecordNameStrategy) -->
                                <orderflow.inventory.events.v1.ReservationExtendedEvent>src/main/proto/orderflow/inventory/events/v1/inventory_events.proto</orderflow.inventory.events.v1.ReservationExtendedEvent>
                                <orderflow.inventory.events.v1.InventoryReleasedEvent>src/main/proto/orderflow/inventory/events/v1/inventory_events.proto</orderflow.inventory.events.v1.InventoryReleasedEvent>
                                <orderflow.inventory.events.v1.ReservationExtensionFailedEvent>src/main/proto/orderflow/inventory/events/v1/inventory_events.proto</orderflow.inventory.events.v1.ReservationExtensionFailedEvent>
                                <orderflow.inventory.events.v1.InventoryConfirmedEvent>src/main/proto/orderflow/inventory/events/v1/inventory_events.proto</orderflow.inventory.events.v1.InventoryConfirmedEvent>
                                <orderflow.inventory.events.v1.InventoryConfirmationFailedEvent>src/main/proto/orderflow/inventory/events/v1/inventory_events.proto</orderflow.inventory.events.v1.InventoryConfirmationFailedEvent>
                            </subjects>

                            <schemaTypes>
                                <!-- Common / Metadata -->
                                <orderflow.common.v1.metadata>PROTOBUF</orderflow.common.v1.metadata>

                                <!-- Payment Commands -->
                                <orderflow.payment.commands.v1.ChargePaymentCommand>PROTOBUF</orderflow.payment.commands.v1.ChargePaymentCommand>
                                <orderflow.payment.commands.v1.CancelPaymentCommand>PROTOBUF</orderflow.payment.commands.v1.CancelPaymentCommand>

                                <!-- Inventory Commands -->
                                <orderflow.inventory.commands.v1.ReleaseInventoryCommand>PROTOBUF</orderflow.inventory.commands.v1.ReleaseInventoryCommand>
                                <orderflow.inventory.commands.v1.ExtendReservationCommand>PROTOBUF</orderflow.inventory.commands.v1.ExtendReservationCommand>
                                <orderflow.inventory.commands.v1.ConfirmReservationCommand>PROTOBUF</orderflow.inventory.commands.v1.ConfirmReservationCommand>

                                <!-- Payment Events -->
                                <orderflow.payment.events.v1.PaymentInitiatedEvent>PROTOBUF</orderflow.payment.events.v1.PaymentInitiatedEvent>
                                <orderflow.payment.events.v1.PaymentInitializationFailedEvent>PROTOBUF</orderflow.payment.events.v1.PaymentInitializationFailedEvent>
                                <orderflow.payment.events.v1.PaymentCancelledEvent>PROTOBUF</orderflow.payment.events.v1.PaymentCancelledEvent>
                                <orderflow.payment.events.v1.PaymentChargedEvent>PROTOBUF</orderflow.payment.events.v1.PaymentChargedEvent>
                                <orderflow.payment.events.v1.PaymentFailedEvent>PROTOBUF</orderflow.payment.events.v1.PaymentFailedEvent>

                                <!-- Inventory Events -->
                                <orderflow.inventory.events.v1.ReservationExtendedEvent>PROTOBUF</orderflow.inventory.events.v1.ReservationExtendedEvent>
                                <orderflow.inventory.events.v1.InventoryReleasedEvent>PROTOBUF</orderflow.inventory.events.v1.InventoryReleasedEvent>
                                <orderflow.inventory.events.v1.ReservationExtensionFailedEvent>PROTOBUF</orderflow.inventory.events.v1.ReservationExtensionFailedEvent>
                                <orderflow.inventory.events.v1.InventoryConfirmedEvent>PROTOBUF</orderflow.inventory.events.v1.InventoryConfirmedEvent>
                                <orderflow.inventory.events.v1.InventoryConfirmationFailedEvent>PROTOBUF</orderflow.inventory.events.v1.InventoryConfirmationFailedEvent>

                                <!-- Order Events -->
                                <orderflow.order.v1.OrderCancelledIntegrationEvent>PROTOBUF</orderflow.order.v1.OrderCancelledIntegrationEvent>
                            </schemaTypes>

                            <references>
                                <orderflow.payment.commands.v1.ChargePaymentCommand>
                                    <reference>
                                        <name>orderflow/common/v1/metadata.proto</name>
                                        <subject>orderflow.common.v1.metadata</subject>
                                    </reference>
                                </orderflow.payment.commands.v1.ChargePaymentCommand>

                                <orderflow.payment.commands.v1.CancelPaymentCommand>
                                    <reference>
                                        <name>orderflow/common/v1/metadata.proto</name>
                                        <subject>orderflow.common.v1.metadata</subject>
                                    </reference>
                                </orderflow.payment.commands.v1.CancelPaymentCommand>

                                <orderflow.inventory.commands.v1.ReleaseInventoryCommand>
                                    <reference>
                                        <name>orderflow/common/v1/metadata.proto</name>
                                        <subject>orderflow.common.v1.metadata</subject>
                                    </reference>
                                </orderflow.inventory.commands.v1.ReleaseInventoryCommand>

                                <orderflow.inventory.commands.v1.ExtendReservationCommand>
                                    <reference>
                                        <name>orderflow/common/v1/metadata.proto</name>
                                        <subject>orderflow.common.v1.metadata</subject>
                                    </reference>
                                </orderflow.inventory.commands.v1.ExtendReservationCommand>

                                <orderflow.inventory.commands.v1.ConfirmReservationCommand>
                                    <reference>
                                        <name>orderflow/common/v1/metadata.proto</name>
                                        <subject>orderflow.common.v1.metadata</subject>
                                    </reference>
                                </orderflow.inventory.commands.v1.ConfirmReservationCommand>

                                <orderflow.payment.events.v1.PaymentInitiatedEvent>
                                    <reference>
                                        <name>orderflow/common/v1/metadata.proto</name>
                                        <subject>orderflow.common.v1.metadata</subject>
                                    </reference>
                                </orderflow.payment.events.v1.PaymentInitiatedEvent>

                                <orderflow.payment.events.v1.PaymentInitializationFailedEvent>
                                    <reference>
                                        <name>orderflow/common/v1/metadata.proto</name>
                                        <subject>orderflow.common.v1.metadata</subject>
                                    </reference>
                                </orderflow.payment.events.v1.PaymentInitializationFailedEvent>

                                <orderflow.payment.events.v1.PaymentCancelledEvent>
                                    <reference>
                                        <name>orderflow/common/v1/metadata.proto</name>
                                        <subject>orderflow.common.v1.metadata</subject>
                                    </reference>
                                </orderflow.payment.events.v1.PaymentCancelledEvent>

                                <orderflow.payment.events.v1.PaymentChargedEvent>
                                    <reference>
                                        <name>orderflow/common/v1/metadata.proto</name>
                                        <subject>orderflow.common.v1.metadata</subject>
                                    </reference>
                                </orderflow.payment.events.v1.PaymentChargedEvent>

                                <orderflow.payment.events.v1.PaymentFailedEvent>
                                    <reference>
                                        <name>orderflow/common/v1/metadata.proto</name>
                                        <subject>orderflow.common.v1.metadata</subject>
                                    </reference>
                                </orderflow.payment.events.v1.PaymentFailedEvent>

                                <orderflow.inventory.events.v1.ReservationExtendedEvent>
                                    <reference>
                                        <name>orderflow/common/v1/metadata.proto</name>
                                        <subject>orderflow.common.v1.metadata</subject>
                                    </reference>
                                </orderflow.inventory.events.v1.ReservationExtendedEvent>

                                <orderflow.inventory.events.v1.InventoryReleasedEvent>
                                    <reference>
                                        <name>orderflow/common/v1/metadata.proto</name>
                                        <subject>orderflow.common.v1.metadata</subject>
                                    </reference>
                                </orderflow.inventory.events.v1.InventoryReleasedEvent>

                                <orderflow.inventory.events.v1.ReservationExtensionFailedEvent>
                                    <reference>
                                        <name>orderflow/common/v1/metadata.proto</name>
                                        <subject>orderflow.common.v1.metadata</subject>
                                    </reference>
                                </orderflow.inventory.events.v1.ReservationExtensionFailedEvent>

                                <orderflow.inventory.events.v1.InventoryConfirmedEvent>
                                    <reference>
                                        <name>orderflow/common/v1/metadata.proto</name>
                                        <subject>orderflow.common.v1.metadata</subject>
                                    </reference>
                                </orderflow.inventory.events.v1.InventoryConfirmedEvent>

                                <orderflow.inventory.events.v1.InventoryConfirmationFailedEvent>
                                    <reference>
                                        <name>orderflow/common/v1/metadata.proto</name>
                                        <subject>orderflow.common.v1.metadata</subject>
                                    </reference>
                                </orderflow.inventory.events.v1.InventoryConfirmationFailedEvent>

                                <orderflow.order.v1.OrderCancelledIntegrationEvent>
                                    <reference>
                                        <name>orderflow/common/v1/metadata.proto</name>
                                        <subject>orderflow.common.v1.metadata</subject>
                                    </reference>
                                </orderflow.order.v1.OrderCancelledIntegrationEvent>
                            </references>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>