<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ═══════════════════════════════════════════════════════════
       Parent POM - Inherits common configuration
   ════════════════════════════════════════════════════════════════ -->
    <parent>
        <groupId>com.echcherqaoui.orderflow</groupId>
        <artifactId>orderflow</artifactId>
        <version>1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <!-- ═══════════════════════════════════════════════════════════
        Project Metadata
    ════════════════════════════════════════════════════════════════ -->
    <artifactId>orderflow-events-contract</artifactId>
    <packaging>jar</packaging>
    <name>Orderflow :: Events Contract</name>
    <description>Shared Protocol Buffer event schemas and generated Java contracts</description>

    <dependencies>
        <!-- Protocol Buffers Java Core -->
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
        </dependency>

        <!-- Confluent Protobuf Serializer for Schema Registry -->
        <dependency>
            <groupId>io.confluent</groupId>
            <artifactId>kafka-protobuf-serializer</artifactId>
        </dependency>
    </dependencies>

    <!-- ═══════════════════════════════════════════════════════════
       Build Configuration
   ════════════════════════════════════════════════════════════════ -->
    <build>
        <plugins>
            <plugin>
                <groupId>io.github.ascopes</groupId>
                <artifactId>protobuf-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>register-schemas</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>io.confluent</groupId>
                        <artifactId>kafka-schema-registry-maven-plugin</artifactId>
                        <version>${kafka-protobuf-serializer.version}</version>
                        <configuration>
                            <schemaRegistryUrls>
                                <schemaRegistryUrl>${schema.registry.url}</schemaRegistryUrl>
                            </schemaRegistryUrls>
                            <messagePath>src/main/proto</messagePath>

                            <subjects>
                                <!-- Matched to QualifiedReferenceSubjectNameStrategy: <package>.<filename> -->
                                <orderflow.common.v1.metadata>src/main/proto/orderflow/common/v1/metadata.proto</orderflow.common.v1.metadata>

                                <!-- Command Schema (RecordNameStrategy) -->
                                <orderflow.payment.commands.v1.ChargePaymentCommand>src/main/proto/orderflow/payment/commands/v1/payment_commands.proto</orderflow.payment.commands.v1.ChargePaymentCommand>

                                <!-- Event Schema (RecordNameStrategy) -->
                                <orderflow.payment.events.v1.PaymentInitiatedEvent>src/main/proto/orderflow/payment/events/v1/payment_events.proto</orderflow.payment.events.v1.PaymentInitiatedEvent>
                            </subjects>

                            <schemaTypes>
                                <orderflow.common.v1.metadata>PROTOBUF</orderflow.common.v1.metadata>
                                <orderflow.payment.commands.v1.ChargePaymentCommand>PROTOBUF</orderflow.payment.commands.v1.ChargePaymentCommand>
                                <orderflow.payment.events.v1.PaymentInitiatedEvent>PROTOBUF</orderflow.payment.events.v1.PaymentInitiatedEvent>
                            </schemaTypes>

                            <references>
                                <orderflow.payment.commands.v1.ChargePaymentCommand>
                                    <reference>
                                        <name>orderflow/common/v1/metadata.proto</name>
                                        <subject>orderflow.common.v1.metadata</subject>
                                    </reference>
                                </orderflow.payment.commands.v1.ChargePaymentCommand>

                                <orderflow.payment.events.v1.PaymentInitiatedEvent>
                                    <reference>
                                        <name>orderflow/common/v1/metadata.proto</name>
                                        <subject>orderflow.common.v1.metadata</subject>
                                    </reference>
                                </orderflow.payment.events.v1.PaymentInitiatedEvent>
                            </references>

                            <compatibilityLevels>
                                <orderflow.common.v1.metadata>BACKWARD</orderflow.common.v1.metadata>
                                <orderflow.payment.commands.v1.ChargePaymentCommand>BACKWARD</orderflow.payment.commands.v1.ChargePaymentCommand>
                                <orderflow.payment.events.v1.PaymentInitiatedEvent>BACKWARD</orderflow.payment.events.v1.PaymentInitiatedEvent>
                            </compatibilityLevels>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
