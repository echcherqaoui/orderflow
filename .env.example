WEBHOOK_SECRET=change_me

##=====================================================================
## ENTITLEMENT SERVICE
##=====================================================================
ENTITLEMENT_SERVICE_PORT=8088
ENTITLEMENT_DB=entitlement_db
KF_ENTITLEMENT_CONSUMER_GROUP_ID=entitlement-service-group

##=====================================================================
## OBSERVABILITY
##=====================================================================
DISCOVERY_MANAGEMENT_PORT=8070
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
TEMPO_PORT=3200
GRAFANA_USER=admin
GRAFANA_PASSWORD=your-grafana-password
OTEL_TRACES_ENDPOINT=http://tempo:4318/v1/traces

##=====================================================================
## LOGGING
##=====================================================================
LOG_LEVEL_GATEWAY=DEBUG