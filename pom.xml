<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.echcherqaoui.orderflow</groupId>
    <artifactId>orderflow</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <modules>
        <module>common/common-exceptions</module>
        <module>common/common-kafka</module>
        <module>common/common-outbox</module>
        <module>common/common-security</module>
        <module>common/orderflow-grpc-contract</module>
        <module>common/orderflow-events-contract</module>

        <module>services/entitlement-service</module>
        <module>services/inventory-service</module>
        <module>services/order-service</module>
        <module>services/payment-service</module>
    </modules>

    <!-- ═══════════════════════════════════════════════════════════
        PROPERTIES
        Centralized version control for JDK, BOMs, processors, and tools.
    ════════════════════════════════════════════════════════════════ -->
    <properties>
        <!-- Build & Compiler Properties -->
        <java.version>21</java.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Framework Dependencies BOM Versions -->
        <spring-boot.version>4.1.1</spring-boot.version>
        <spring-cloud.version>2025.1.3</spring-cloud.version>
        <spring-grpc.version>1.0.3</spring-grpc.version>

        <!-- Annotation Processors -->
        <lombok.version>1.18.46</lombok.version>
        <mapstruct.version>1.6.3</mapstruct.version>
        <lombok-mapstruct-binding.version>0.2.0</lombok-mapstruct-binding.version>

        <!-- Protobuf & gRPC Code Generation Versions -->
        <grpc.version>1.69.1</grpc.version>
        <protobuf.version>3.25.5</protobuf.version>
        <protobuf-maven-plugin.version>5.1.7</protobuf-maven-plugin.version>
        <annotations-api.version>6.0.53</annotations-api.version>

        <!-- Confluent Schema Registry Protobuf Serializer for Kafka event serialization -->
        <kafka-protobuf-serializer.version>7.7.7</kafka-protobuf-serializer.version>

        <!-- Schema Registry endpoint used by the plugin for schema registration -->
        <schema.registry.url>http://localhost:8181</schema.registry.url>

        <!-- Build Plugin Versions -->
        <maven-surefire-plugin.version>3.5.2</maven-surefire-plugin.version>
        <maven-dependency-plugin.version>3.8.1</maven-dependency-plugin.version>

        <!-- Security Overrides -->
        <jackson3.version>3.2.3</jackson3.version>
        <jackson2.version>2.22.3</jackson2.version>
        <httpclient.version>4.5.14</httpclient.version>
        <avro.version>1.11.5</avro.version>
        <logback.version>1.6.5</logback.version>
        <postgresql.version>42.7.14</postgresql.version>
        <bouncycastle.version>1.86</bouncycastle.version>
        <zstd-jni.version>1.5.7-14</zstd-jni.version>
        <lz4-java.version>1.11.4</lz4-java.version>
        <snappy-java.version>1.1.10.9</snappy-java.version>
        <kafka_2.13.version>4.3.1</kafka_2.13.version>
        <tomcat.version>11.0.26</tomcat.version>
        <netty.version>4.2.18.Final</netty.version>
    </properties>

    <!-- ═══════════════════════════════════════════════════════════
        REPOSITORIES
        Confluent remote repositories for Java dependencies and Maven plugins.
    ════════════════════════════════════════════════════════════════ -->
    <repositories>
        <repository>
            <id>confluent</id>
            <name>Confluent Repository</name>
            <url>https://packages.confluent.io/maven/</url>
        </repository>
    </repositories>

    <pluginRepositories>
        <pluginRepository>
            <id>confluent</id>
            <name>Confluent Repository</name>
            <url>https://packages.confluent.io/maven/</url>
        </pluginRepository>
    </pluginRepositories>

    <!-- ═══════════════════════════════════════════════════════════
        COMMON DEPENDENCIES
         Inherited by every child module automatically.
    ════════════════════════════════════════════════════════════════ -->
    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <!-- ═══════════════════════════════════════════════════════════
         DEPENDENCY MANAGEMENT
         Manages RUNTIME/COMPILE library versions across child modules.
         Note: Imported BOMs do NOT manage Maven plugin versions.
    ════════════════════════════════════════════════════════════════ -->
    <dependencyManagement>
        <dependencies>
            <!-- Fixes CVE-2026-89407, CVE-2026-89425, CVE-2026-68497, CVE-2026-91777, CVE-2026-91776, CVE-2026-83557, CVE-2026-19032 -->
            <dependency>
                <groupId>tools.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson3.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Fixes CVE-2026-89407, CVE-2026-89425, CVE-2026-68497, CVE-2026-91777, CVE-2026-91776, CVE-2026-83557, CVE-2026-19032 -->
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson2.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Fixes CVE-2026-17508, CVE-2026-71889, CVE-2026-71891 -->
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bc-jdk18on-bom</artifactId>
                <version>${bouncycastle.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Fixes CVE-2026-93569, CVE-2026-93567, CVE-2026-93568, CVE-2026-93488, CVE-2026-93558, CVE-2026-93565, CVE-2026-89044, CVE-2026-93573, CVE-2026-93566 -->
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-bom</artifactId>
                <version>${netty.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Spring Boot BOM: Manages core Spring Boot starter versions -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Spring Cloud BOM: Manages distributed systems/gateway libraries -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Spring gRPC BOM: Manages gRPC core, stub, and transport runtime libraries -->
            <dependency>
                <groupId>org.springframework.grpc</groupId>
                <artifactId>spring-grpc-dependencies</artifactId>
                <version>${spring-grpc.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Internal modules -->
            <dependency>
                <groupId>com.echcherqaoui.orderflow</groupId>
                <artifactId>common-exceptions</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>com.echcherqaoui.orderflow</groupId>
                <artifactId>common-kafka</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>com.echcherqaoui.orderflow</groupId>
                <artifactId>common-outbox</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>com.echcherqaoui.orderflow</groupId>
                <artifactId>common-security</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>com.echcherqaoui.orderflow</groupId>
                <artifactId>orderflow-events-contract</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>com.echcherqaoui.orderflow</groupId>
                <artifactId>orderflow-grpc-contract</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Provides @javax.annotation.Generated for Protobuf/gRPC generated code -->
            <dependency>
                <groupId>org.apache.tomcat</groupId>
                <artifactId>annotations-api</artifactId>
                <version>${annotations-api.version}</version>
                <scope>provided</scope>
            </dependency>

            <!-- Confluent Schema Registry serializer for Protobuf-encoded Kafka event topics -->
            <dependency>
                <groupId>io.confluent</groupId>
                <artifactId>kafka-protobuf-serializer</artifactId>
                <version>${kafka-protobuf-serializer.version}</version>
            </dependency>

            <!-- Core Google Protocol Buffers Java runtime library for serialization and generated code execution -->
            <dependency>
                <groupId>com.google.protobuf</groupId>
                <artifactId>protobuf-java</artifactId>
                <version>${protobuf.version}</version>
            </dependency>

            <!-- Protobuf utilities providing JSON conversion (JsonFormat), printing, and dynamic message handling -->
            <dependency>
                <groupId>com.google.protobuf</groupId>
                <artifactId>protobuf-java-util</artifactId>
                <version>${protobuf.version}</version>
            </dependency>

            <!-- Fixes CVE-2020-13956 -->
            <dependency>
                <groupId>org.apache.httpcomponents</groupId>
                <artifactId>httpclient</artifactId>
                <version>${httpclient.version}</version>
            </dependency>

            <!-- Fixes CVE-2025-33042 -->
            <dependency>
                <groupId>org.apache.avro</groupId>
                <artifactId>avro</artifactId>
                <version>${avro.version}</version>
                <scope>compile</scope>
            </dependency>

            <!-- Fixes CVE-2026-19880 -->
            <dependency>
                <groupId>ch.qos.logback</groupId>
                <artifactId>logback-classic</artifactId>
                <version>${logback.version}</version>
            </dependency>

            <!-- CVE-2026-13006 -->
            <dependency>
                <groupId>ch.qos.logback</groupId>
                <artifactId>logback-core</artifactId>
                <version>${logback.version}</version>
            </dependency>

            <!-- Fixes CVE-2026-65637, CVE-2026-65905, CVE-2026-65182, CVE-2026-68525, CVE-2026-86350, CVE-2026-68569, CVE-2026-65183, CVE-2026-66422, CVE-2026-77762, CVE-2026-68763, CVE-2026-65927, CVE-2026-78383, CVE-2026-75973, CVE-2026-78437, CVE-2026-73581, CVE-2026-77756 -->
            <dependency>
                <groupId>org.apache.tomcat.embed</groupId>
                <artifactId>tomcat-embed-core</artifactId>
                <version>${tomcat.version}</version>
            </dependency>

            <!--Fixes CVE-2026-76183, CVE-2026-77791, CVE-2026-87022, CVE-2026-79677, CVE-2026-73180-->
            <dependency>
                <groupId>org.apache.tomcat.embed</groupId>
                <artifactId>tomcat-embed-websocket</artifactId>
                <version>${tomcat.version}</version>
            </dependency>

            <!-- No CVE: pinned to keep tomcat-embed-el on the same version as core and websocket -->
            <dependency>
                <groupId>org.apache.tomcat.embed</groupId>
                <artifactId>tomcat-embed-el</artifactId>
                <version>${tomcat.version}</version>
            </dependency>

            <!-- Fixes CVE-2026-107314, CVE-2026-107315 -->
            <dependency>
                <groupId>org.postgresql</groupId>
                <artifactId>postgresql</artifactId>
                <version>${postgresql.version}</version>
            </dependency>

            <!-- Fixes CVE-2026-87795, CVE-2026-87823, CVE-2026-89046, CVE-2026-90560, CVE-2026-87825, CVE-2026-87877, CVE-2026-87824, CVE-2026-90852, CVE-2026-89045 -->
            <dependency>
                <groupId>com.github.luben</groupId>
                <artifactId>zstd-jni</artifactId>
                <version>${zstd-jni.version}</version>
            </dependency>

            <!-- Fixes CVE-2026-106451, CVE-2026-59949, CVE-2026-106453, CVE-2026-106452, CVE-2026-106450, CVE-2026-106449 -->
            <dependency>
                <groupId>at.yawk.lz4</groupId>
                <artifactId>lz4-java</artifactId>
                <version>${lz4-java.version}</version>
            </dependency>

            <!-- Fixes CVE-2026-90559 -->
            <dependency>
                <groupId>org.xerial.snappy</groupId>
                <artifactId>snappy-java</artifactId>
                <version>${snappy-java.version}</version>
            </dependency>

            <!-- Fixes CVE-2026-41115 -->
            <dependency>
                <groupId>org.apache.kafka</groupId>
                <artifactId>kafka_2.13</artifactId>
                <version>${kafka_2.13.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- ═══════════════════════════════════════════════════════════
         BUILD & PLUGIN MANAGEMENT
         Defines plugin configurations and versions once at the root.
         Child modules inherit these settings when referencing the plugin.
    ════════════════════════════════════════════════════════════════ -->
    <build>

        <plugins>
            <!-- Dynamically resolves artifact paths to set mockito-core as a JVM javaagent during unit tests -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <goals><goal>properties</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>-javaagent:${org.mockito:mockito-core:jar}</argLine>
                </configuration>
            </plugin>
        </plugins>

        <pluginManagement>
            <plugins>
                <!-- Core Build Plugins -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-dependency-plugin</artifactId>
                    <version>${maven-dependency-plugin.version}</version>
                </plugin>
                <!-- Spring Boot Executable Packaging Plugin -->
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                    <configuration>
                        <excludes>
                            <!-- Exclude Lombok from the final deployment fat-JAR -->
                            <exclude>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                            </exclude>
                        </excludes>
                    </configuration>
                </plugin>

                <!-- Java Compiler & Annotation Processing Pipeline -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <release>${java.version}</release>
                        <annotationProcessorPaths>
                            <!-- Lombok: Generates getters/setters/builders first -->
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                            <!-- MapStruct: Generates mapper implementations second -->
                            <path>
                                <groupId>org.mapstruct</groupId>
                                <artifactId>mapstruct-processor</artifactId>
                                <version>${mapstruct.version}</version>
                            </path>
                            <!-- Integration Bridge: Allows MapStruct to access Lombok-generated code -->
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok-mapstruct-binding</artifactId>
                                <version>${lombok-mapstruct-binding.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>

                <!-- Compiles Protobuf schemas and generates Java gRPC stub code -->
                <plugin>
                    <groupId>io.github.ascopes</groupId>
                    <artifactId>protobuf-maven-plugin</artifactId>
                    <version>${protobuf-maven-plugin.version}</version>
                    <configuration>
                        <protoc>${protobuf.version}</protoc>
                        <plugins>
                            <plugin kind="binary-maven">
                                <groupId>io.grpc</groupId>
                                <artifactId>protoc-gen-grpc-java</artifactId>
                                <version>${grpc.version}</version>
                            </plugin>
                        </plugins>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>